        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 28px; align-items: stretch">
          <!-- Monitor CRT frontal grande -->
          <div class="k2-tv" style="padding: 20px 20px 30px; border-color: #3ff0ff; box-shadow: 0 0 35px rgba(63,240,255,.22), inset 0 2px 0 rgba(255,255,255,.15)">
            <div style="position: relative; border-radius: 20px; overflow: hidden; padding: 22px 22px 20px; background: linear-gradient(180deg, #07021a 0%, #1d083d 58%, #4a0e5c 76%, #12021f 76.5%); box-shadow: inset 0 0 50px rgba(0,0,0,.9), inset 0 0 0 3px #0b0420; min-height: 360px; display: flex; flex-direction: column; justify-content: space-between">
              <!-- Sol y grilla de fondo dentro del CRT -->
