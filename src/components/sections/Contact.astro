<!-- formulario de contacto (variante default) -->
<script>
  const form = document.querySelector<HTMLFormElement>('[data-ct-form]');
  if (form) {
    const $ = <T extends Element>(s: string) => form.closest('#contacto')!.querySelector<T>(s)!;
    const status = $<HTMLElement>('[data-ct-status]');
    const credit = $<HTMLElement>('[data-ct-credit]');
    const score = $<HTMLElement>('[data-ct-score]');
    const count = $<HTMLElement>('[data-ct-count]');
    const env = $<HTMLImageElement>('[data-ct-env]');
    const submit = $<HTMLButtonElement>('[data-ct-submit]');
    const msg = form.querySelector<HTMLTextAreaElement>('textarea[name="mensaje"]')!;
    const idle = 'PRESS START · LLENA LOS CAMPOS';

    const setStatus = (txt: string, tone = '') => {
      status.textContent = txt;
      status.dataset.tone = tone;
    };
    const refresh = () => {
      const ok = form.checkValidity();
      credit.textContent = ok ? '01' : '00';
      form.classList.toggle('is-ready', ok);
      const pts = (form.querySelector<HTMLInputElement>('[name="nombre"]')!.value.length * 50) + msg.value.length * 10;
      score.textContent = String(Math.min(pts, 999999)).padStart(6, '0');
      count.textContent = String(msg.value.length);
      if (status.dataset.tone !== 'ok') setStatus(ok ? '★ CREDIT 01 · PRESS START ★' : idle, ok ? 'ready' : '');
    };
    form.addEventListener('input', () => { if (status.dataset.tone === 'ok') status.dataset.tone = ''; refresh(); });

    // sin JS el formulario igual se envía a Netlify; aquí mostramos el estado sin recargar
    if (new URLSearchParams(location.search).has('enviado')) setStatus('★ MENSAJE ENVIADO · GAME SAVED ★', 'ok');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        setStatus('✕ FALTAN DATOS · REVISA LOS CAMPOS', 'err');
        form.classList.add('is-shake');
        setTimeout(() => form.classList.remove('is-shake'), 450);
        (form.querySelector(':invalid') as HTMLElement | null)?.focus();
        return;
      }
      submit.disabled = true;
      setStatus('ENVIANDO ▮▮▮▯▯ ...', 'busy');
      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
        const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
        if (!res.ok) throw new Error(String(res.status));
        env.classList.remove('is-fly');
        void env.offsetWidth;
        env.classList.add('is-fly');
        form.reset();
        refresh();
        setStatus('★ MENSAJE ENVIADO · GAME SAVED ★', 'ok');
      } catch {
        setStatus('✕ ERROR DE CONEXIÓN · ESCRÍBEME A soyronyvargas@gmail.com', 'err');
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
