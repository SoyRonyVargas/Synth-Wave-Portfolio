---
import site from '../../data/site.json';
const { variant = 'default' } = Astro.props;
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappText)}`;
---

{variant === 'default' && (
  <section id="contacto" style="position: relative; overflow: hidden; background: radial-gradient(ellipse at 50% 40%, #2a1260 0%, #0b0420 65%)">
    <div class="rw-stars-static" aria-hidden="true" style="position: absolute; inset: 0 0 45% 0; opacity: .7"></div>
    <!-- máquinas de fondo -->
    <img class="rw-hide-sm" src="/assets/arcade.webp" alt="" aria-hidden="true" style="position: absolute; z-index: 0; left: max(0%, calc(50% - 760px)); bottom: 170px; width: 190px; height: auto; opacity: .18; filter: brightness(.5) blur(2px)">
    <img class="rw-hide-sm" src="/assets/arcade.webp" alt="" aria-hidden="true" style="position: absolute; z-index: 0; right: max(0%, calc(50% - 760px)); bottom: 170px; width: 190px; height: auto; opacity: .18; filter: brightness(.5) blur(2px); transform: scaleX(-1)">
    <!-- piso con reflejo -->
    <div aria-hidden="true" style="position: absolute; z-index: 0; left: 0; right: 0; bottom: 0; height: 190px; overflow: hidden; border-top: 2px solid #ff2fb3; box-shadow: 0 -6px 30px rgba(255,47,179,.5); background: #12021f; perspective: 260px">
      <div class="rw-about-floor" style="opacity: .7"></div>
    </div>

    <div style="position: relative; z-index: 2; max-width: 1120px; margin: 0 auto; padding: 96px 24px 0">
      <div style="text-align: center">
        <p style="margin: 0 0 22px; font-family: 'Press Start 2P', monospace; font-size: 11px; letter-spacing: 3px; color: #fff27a">05 · CONTACTO</p>
        <h2 class="rw-blink-soft" style="position: relative; display: inline-block; margin: 0 0 18px; font-weight: 400; line-height: 1">
          <span class="rw-chrome-wrap" style="font-size: clamp(40px, 6.4vw, 92px)"><span class="rw-chrome-depth" aria-hidden="true">INSERT COIN</span><span class="rw-chrome">INSERT COIN</span></span>
          <span class="rw-script" aria-hidden="true" style="position: absolute; right: -8px; bottom: -32px; white-space: nowrap; font-size: clamp(30px, 3.6vw, 52px); transform: rotate(-6deg); color: #3ff0ff; -webkit-text-stroke: 1px #e6fdff; text-shadow: 0 0 6px #3ff0ff, 0 0 18px #3ff0ff">player 2</span>
        </h2>
        <p style="margin: 30px auto 0; max-width: 620px; font-size: 16px; line-height: 1.6; color: #d9c8f5">¿Tienes un proyecto o una vacante? Escribe tu nombre en la tabla, mete la moneda y el mensaje me llega directo. Respondo en menos de 24 horas.</p>
      </div>

      <div class="ct-grid">
        <!-- gabinete arcade con el menú de accesos rápidos -->
        <div class="ct-arcade">
          <div style="position: relative; width: 100%">
            <img src="/assets/arcade.webp" alt="Máquina arcade con menú de contacto en la pantalla" style="position: relative; z-index: 1; display: block; width: 100%; height: auto; filter: drop-shadow(0 0 40px rgba(255,47,179,.35))">
            <div class="rw-coin" aria-hidden="true" style="left: 58.5%; top: 71%">25¢</div>
            <div style="position: absolute; z-index: 2; left: 17.8%; top: 13.4%; width: 70.4%; height: 31.8%; transform: skewX(-2.2deg); transform-origin: top center; padding: 5.5% 6%; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; border-radius: 12px; border: 2px solid rgba(63,240,255,.45); background: linear-gradient(180deg, #090218 0%, #1d083d 62%, #4a0e5c 80%, #12021f 80.5%); box-shadow: 0 0 0 6px #000, inset 0 0 26px rgba(63,240,255,.22), 0 0 22px rgba(255,47,179,.3)">
              <div aria-hidden="true" style="position: absolute; left: 50%; top: 48%; width: 44%; aspect-ratio: 1; translate: -50% 0; border-radius: 50%; opacity: .28; background: linear-gradient(180deg, #fff27a 0%, #ff5e7e 65%, #ff2fb3 100%); -webkit-mask-image: linear-gradient(#000 0 58%, transparent 58% 64%, #000 64% 74%, transparent 74% 80%, #000 80%); mask-image: linear-gradient(#000 0 58%, transparent 58% 64%, #000 64% 74%, transparent 74% 80%, #000 80%); pointer-events: none"></div>
              <div aria-hidden="true" style="position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; padding-bottom: 4px; border-bottom: 1px solid rgba(63,240,255,.28); font-family: 'Press Start 2P', monospace; font-size: clamp(6px, 1.4vw, 8px); letter-spacing: .5px">
                <span style="color: #ff8ad8">1UP <span style="color: #fff">002026</span></span>
                <span style="color: #3ff0ff">SELECT</span>
              </div>
              <nav class="rw-menu" aria-label="Contacto directo" style="position: relative; z-index: 1; display: flex; flex-direction: column; gap: 5px; font-family: 'Press Start 2P', monospace; font-size: clamp(7px, 1.6vw, 9.5px)">
                <a href="mailto:soyronyvargas@gmail.com" style="display: flex; align-items: center; justify-content: space-between; padding: 7px 9px; border-radius: 4px; border: 1.5px solid rgba(63,240,255,.4); background: rgba(11,4,32,.82); color: #7dffcf; text-decoration: none"><span>▶ EMAIL</span><span aria-hidden="true" style="font-size: .8em; opacity: .75">✉</span></a>
                <a href="https://linkedin.com/in/rony-vargas-212bb2182" target="_blank" rel="noopener noreferrer" style="display: flex; align-items: center; justify-content: space-between; padding: 7px 9px; border-radius: 4px; border: 1.5px solid rgba(63,240,255,.4); background: rgba(11,4,32,.82); color: #7dffcf; text-decoration: none"><span>▶ LINKEDIN</span><span aria-hidden="true" style="font-size: .8em; opacity: .75">↗</span></a>
                <a href="https://github.com/SoyRonyVargas" target="_blank" rel="noopener noreferrer" style="display: flex; align-items: center; justify-content: space-between; padding: 7px 9px; border-radius: 4px; border: 1.5px solid rgba(63,240,255,.4); background: rgba(11,4,32,.82); color: #7dffcf; text-decoration: none"><span>▶ GITHUB</span><span aria-hidden="true" style="font-size: .8em; opacity: .75">↗</span></a>
                <a href="/Rony_Vargas_CV_2026.pdf" download="Rony_Vargas_CV_2026.pdf" style="display: flex; align-items: center; justify-content: space-between; padding: 7px 9px; border-radius: 4px; border: 1.5px solid rgba(255,47,179,.55); background: rgba(42,12,78,.85); color: #fff27a; text-decoration: none"><span>▶ DESCARGAR CV</span><span aria-hidden="true" style="font-size: .8em">↓</span></a>
              </nav>
              <div aria-hidden="true" style="position: absolute; inset: 0; z-index: 2; pointer-events: none; background: repeating-linear-gradient(rgba(0,0,0,.28) 0 2px, transparent 2px 4px)"></div>
            </div>
          </div>
          <img src="/assets/arcade.webp" alt="" aria-hidden="true" style="display: block; width: 100%; height: 120px; object-fit: cover; object-position: bottom; transform: scaleY(-1); opacity: .22; -webkit-mask-image: linear-gradient(to top, #000, transparent); mask-image: linear-gradient(to top, #000, transparent)">
        </div>

        <!-- consola "HIGH SCORE ENTRY" con el formulario -->
        <div class="ct-cab">
          <div class="ct-marquee" aria-hidden="true">
            <span>★ RV-ARCADE · MESSAGE ENTRY ★</span>
            <span class="ct-credit">CREDIT <b data-ct-credit>00</b></span>
          </div>

          <div class="ct-screen">
            <div class="ct-screen-sun" aria-hidden="true"></div>
            <div class="ct-screen-grid" aria-hidden="true"></div>

            <form class="ct-form" name="contacto" method="POST" action="/?enviado=1#contacto" data-netlify="true" netlify-honeypot="bot-field" data-ct-form novalidate>
              <input type="hidden" name="form-name" value="contacto">
              <p class="ct-hp" aria-hidden="true"><label>No llenar: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>

              <div class="ct-hud" aria-hidden="true">
                <span style="color: #ff8ad8">2UP <span style="color: #fff">READY</span></span>
                <span style="color: #fff27a">SCORE <span data-ct-score style="color: #3ff0ff">000000</span></span>
              </div>

              <div class="ct-row">
                <div class="ct-field">
                  <label for="ct-name">PLAYER NAME</label>
                  <input id="ct-name" name="nombre" type="text" required maxlength="60" autocomplete="name" placeholder="TU NOMBRE">
                </div>
                <div class="ct-field">
                  <label for="ct-email">EMAIL</label>
                  <input id="ct-email" name="email" type="email" required maxlength="120" autocomplete="email" placeholder="tu@correo.com">
                </div>
              </div>

              <fieldset class="ct-modes">
                <legend>GAME MODE</legend>
                <label><input type="radio" name="motivo" value="Proyecto" checked><span>PROYECTO</span></label>
                <label><input type="radio" name="motivo" value="Vacante"><span>VACANTE</span></label>
                <label><input type="radio" name="motivo" value="Freelance"><span>FREELANCE</span></label>
                <label><input type="radio" name="motivo" value="Saludo"><span>SALUDO</span></label>
              </fieldset>

              <div class="ct-field">
                <label for="ct-msg">MENSAJE <span class="ct-count" aria-hidden="true"><span data-ct-count>0</span>/1000</span></label>
                <textarea id="ct-msg" name="mensaje" required minlength="10" maxlength="1000" rows="5" placeholder="Cuéntame del proyecto, la vacante o la idea..."></textarea>
              </div>

              <div class="ct-controls">
                <div class="ct-slot" aria-hidden="true">
                  <span class="ct-slot-mouth"></span>
                  <span class="ct-slot-txt">25¢</span>
                </div>
                <button type="submit" class="ct-start" data-ct-submit>
                  <span class="ct-start-btn" aria-hidden="true"></span>
                  <span class="ct-start-txt">START<small>ENVIAR MENSAJE</small></span>
                </button>
                <img class="ct-env" src="/assets/envelope.webp" alt="" aria-hidden="true" data-ct-env>
              </div>

              <p class="ct-status" role="status" aria-live="polite" data-ct-status>PRESS START · LLENA LOS CAMPOS</p>
            </form>

            <div class="ct-scan" aria-hidden="true"></div>
          </div>

          <div class="ct-foot" aria-hidden="true">
            <span>CRT · RV-85</span>
            <span class="ct-led">● ONLINE · CANCÚN MX</span>
          </div>
        </div>
      </div>

      <div class="ct-alt">
        <p style="margin: 0; font-size: 15px; color: #e6d9fb">¿Prefieres algo más directo?</p>
        <div class="ct-alt-btns">
          <a class="ct-alt-btn ct-alt-btn--wa" href={wa} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">✆</span> WHATSAPP · +52 984 435 0872</a>
          <a class="ct-alt-btn" href="mailto:soyronyvargas@gmail.com"><span aria-hidden="true">✉</span> soyronyvargas@gmail.com</a>
        </div>
      </div>
    </div>

  </section>
)}

{variant === 'home1' && (
  <section id="contacto" style="position: relative; overflow: hidden; background: radial-gradient(ellipse at 50% 35%, #2a1260 0%, #0b0420 70%); border-top: 2px solid #3a1d6e">
