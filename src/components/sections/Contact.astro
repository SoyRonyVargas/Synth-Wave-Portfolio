        <div style="margin: -6px -6px 24px; padding: 14px 20px; border-radius: 10px; border: 2px solid #fff27a; background: linear-gradient(90deg, #ff2fb3 0%, #6a1b7a 50%, #3ff0ff 100%); box-shadow: 0 0 25px rgba(255,47,179,.5), inset 0 0 16px rgba(255,255,255,.35); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px">
