    <img class="rw-hide-sm" src="/assets/arcade.webp" alt="" aria-hidden="true" style="position: absolute; z-index: 0; right: max(1%, calc(50% - 690px)); bottom: 130px; width: 230px; height: auto; opacity: .32; filter: brightness(.6) saturate(1.2) hue-rotate(-45deg) blur(1px); transform: scaleX(-1)">

    <!-- piso de cuadrícula synthwave -->
    <div aria-hidden="true" style="position: absolute; z-index: 0; left: 0; right: 0; bottom: 0; height: 190px; overflow: hidden; border-top: 2px solid #ff2fb3; box-shadow: 0 -6px 30px rgba(255,47,179,.55); background: #12021f; perspective: 260px">
