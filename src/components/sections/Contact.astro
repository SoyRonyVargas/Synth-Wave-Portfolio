---
---
<!-- CONTACTO: salón de arcade -->
  <section id="contacto" style="position: relative; overflow: hidden; background: radial-gradient(ellipse at 50% 45%, #2a1260 0%, #0b0420 65%)">
    <!-- máquinas de fondo -->
    <img class="rw-hide-sm" src="/assets/arcade.webp" alt="" style="position: absolute; z-index: 0; left: max(2%, calc(50% - 560px)); bottom: 150px; width: 250px; height: auto; opacity: .35; filter: brightness(.55) saturate(1.2) hue-rotate(40deg) blur(1px)">
    <img class="rw-hide-sm" src="/assets/arcade.webp" alt="" style="position: absolute; z-index: 0; right: max(2%, calc(50% - 560px)); bottom: 150px; width: 250px; height: auto; opacity: .35; filter: brightness(.55) saturate(1.2) hue-rotate(-60deg) blur(1px); transform: scaleX(-1)">
    <img class="rw-hide-sm" src="/assets/arcade.webp" alt="" style="position: absolute; z-index: 0; left: max(0%, calc(50% - 720px)); bottom: 170px; width: 190px; height: auto; opacity: .18; filter: brightness(.5) blur(2px)">
    <img class="rw-hide-sm" src="/assets/arcade.webp" alt="" style="position: absolute; z-index: 0; right: max(0%, calc(50% - 720px)); bottom: 170px; width: 190px; height: auto; opacity: .18; filter: brightness(.5) blur(2px); transform: scaleX(-1)">
    <figure class="rw-sketch rw-hide-sm rw-float " style="position: absolute; z-index: 1; right: max(4%, calc(50% - 520px)); bottom: 120px; width: 210px; rotate: -6deg;">
        <svg viewBox="0 0 230 185" role="img" aria-label="Boceto: teléfono de disco">
          <g fill="none" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
            <path d="M34 168 L54 86 L176 86 L196 168 Z" stroke="#ff2fb3" fill="rgba(255,47,179,.07)"></path>
            <path class="rw-sk-handset" d="M22 74 C22 42 64 40 74 56 L156 56 C166 40 208 42 208 74 L188 82 C182 70 170 70 166 76 L64 76 C60 70 48 70 42 82 Z" stroke="#3ff0ff"></path>
            <circle cx="115" cy="126" r="32" stroke="#fff27a"></circle>
            <circle cx="115" cy="126" r="10" stroke="#fff27a"></circle>
            <g stroke="#fff27a" stroke-width="2"><circle cx="115" cy="102" r="5"></circle><circle cx="132" cy="108" r="5"></circle><circle cx="139" cy="124" r="5"></circle><circle cx="133" cy="141" r="5"></circle><circle cx="116" cy="149" r="5"></circle><circle cx="98" cy="142" r="5"></circle><circle cx="91" cy="126" r="5"></circle><circle cx="98" cy="109" r="5"></circle></g>
            <path d="M196 150 C214 150 206 162 220 162 C232 162 222 176 214 178" stroke="#c9c9d6" stroke-width="2"></path>
          </g>
        </svg>
        <figcaption class="rw-sketch-tag">3D PENDIENTE · TELÉFONO DE DISCO</figcaption>
      </figure>
    <!-- piso con reflejo -->
    <div aria-hidden="true" style="position: absolute; z-index: 0; left: 0; right: 0; bottom: 0; height: 190px; overflow: hidden; border-top: 2px solid #ff2fb3; box-shadow: 0 -6px 30px rgba(255,47,179,.5); background: #12021f; perspective: 260px">
      <div class="rw-about-floor" style="opacity: .7"></div>
    </div>

    <div style="position: relative; z-index: 2; max-width: 1000px; margin: 0 auto; padding: 96px 24px 0; display: flex; flex-direction: column; align-items: center">
      <p style="margin: 0 0 22px; font-family: 'Press Start 2P', monospace; font-size: 11px; letter-spacing: 3px; color: #fff27a">05 · CONTACTO</p>
      <h2 class="rw-blink-soft" style="margin: 0 0 30px; text-align: center; font-weight: 400; line-height: 1"><span class="rw-chrome-wrap" style="font-size: clamp(40px, 6.4vw, 92px)"><span class="rw-chrome-depth" aria-hidden="true">INSERT COIN</span><span class="rw-chrome">INSERT COIN</span></span></h2>
      <div style="position: relative; width: 100%; max-width: 460px">
        <img src="/assets/arcade.webp" alt="Máquina arcade con menú de contacto en la pantalla" style="position: relative; z-index: 1; display: block; width: 100%; height: auto; filter: drop-shadow(0 0 40px rgba(255,47,179,.35))">
        <!-- moneda cayendo -->
        <div class="rw-coin" aria-hidden="true">25¢</div>
        <div style="position: absolute; z-index: 2; left: 19%; top: 14.8%; width: 68.5%; height: 31%; padding: 6% 7%; display: flex; flex-direction: column; justify-content: center; overflow: hidden; border-radius: 6px; background: radial-gradient(ellipse at center, rgba(40,10,90,.65), rgba(3,3,10,.9) 80%)">
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8%">
            <p style="margin: 0; font-family: 'Press Start 2P', monospace; font-size: clamp(8px, 2.6vw, 12px); color: #fff">¿CONTINUE?</p>
            <div aria-hidden="true" style="height: 22px; overflow: hidden; font-family: 'Press Start 2P', monospace; font-size: 18px; line-height: 22px; color: #ff3355">
              <div class="rw-countdown" style="display: flex; flex-direction: column"><span>9</span><span>8</span><span>7</span><span>6</span><span>5</span><span>4</span><span>3</span><span>2</span><span>1</span><span>0</span></div>
            </div>
          </div>
          <nav class="rw-menu" aria-label="Contacto" style="display: flex; flex-direction: column; gap: 2px; font-family: 'Press Start 2P', monospace; font-size: clamp(8px, 2.3vw, 11px)">
            <a href="mailto:soyronyvargas@gmail.com" style="display: block; padding: 9px 8px; color: #7dffcf; text-decoration: none">▶ EMAIL</a>
            <a href="https://linkedin.com/in/rony-vargas-212bb2182" style="display: block; padding: 9px 8px; color: #7dffcf; text-decoration: none">▶ LINKEDIN</a>
            <a href="https://github.com/SoyRonyVargas" style="display: block; padding: 9px 8px; color: #7dffcf; text-decoration: none">▶ GITHUB</a>
            <a href="/Rony_Vargas_CV_2026.pdf" download="Rony_Vargas_CV_2026.pdf" style="display: block; padding: 9px 8px; color: #7dffcf; text-decoration: none">▶ DESCARGAR CV</a>
          </nav>
          <div aria-hidden="true" style="position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(rgba(0,0,0,.25) 0 2px, transparent 2px 4px), linear-gradient(115deg, transparent 55%, rgba(255,255,255,.06) 55% 65%, transparent 65%)"></div>
        </div>
        <!-- reflejo en el piso -->
        <img src="/assets/arcade.webp" alt="" style="display: block; width: 100%; height: 140px; object-fit: cover; object-position: bottom; transform: scaleY(-1); opacity: .22; -webkit-mask-image: linear-gradient(to top, #000, transparent); mask-image: linear-gradient(to top, #000, transparent)">
      </div>
      <p style="position: relative; z-index: 2; margin: 0; padding: 20px 0 60px; font-size: 15px; color: #e6d9fb; text-align: center">¿Tienes un proyecto o una vacante? Escríbeme a <a href="mailto:soyronyvargas@gmail.com" style="color: #fff27a">soyronyvargas@gmail.com</a></p>
    </div>
  </section>
