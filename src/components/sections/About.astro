---
---
<!-- SOBRE MÍ (basado en la versión 1) -->
  <section id="sobre-mi" style="position: relative; overflow: hidden; background: linear-gradient(180deg, #0b0420 0%, #1a0838 62%, #4a0f6b 88%, #b0186e 100%); border-top: 1px solid #3a1d6e">
    <div style="position: relative; z-index: 3; max-width: 1240px; margin: 0 auto; padding: 112px 24px 330px; display: flex; flex-wrap: wrap; gap: 64px; align-items: center">
      <!-- marco CRT para la foto -->
      <div style="flex: 1 1 380px; min-width: 0; display: flex; justify-content: center">
        <div style="width: 100%; max-width: 420px; padding: 22px; border-radius: 22px; background: #22104a; border: 2px solid #ff2fb3; box-shadow: 0 0 40px rgba(255,47,179,.35), inset 0 0 0 6px #160733">
          <div style="position: relative; aspect-ratio: 4 / 5; border-radius: 14px; overflow: hidden; background: radial-gradient(circle at 50% 40%, #3a1d6e 0%, #12021f 75%); display: flex; align-items: center; justify-content: center">
            <span style="font-family: 'Press Start 2P', monospace; font-size: 12px; letter-spacing: 2px; color: #3ff0ff">[TU FOTO]</span>
            <div aria-hidden="true" style="position: absolute; inset: 0; background: repeating-linear-gradient(180deg, rgba(255,255,255,.05) 0 2px, transparent 2px 4px)"></div>
          </div>
          <p style="margin: 16px 0 0; display: flex; justify-content: space-between; font-family: 'Press Start 2P', monospace; font-size: 10px; letter-spacing: 1px; color: #d9c8f5"><span>PLAYER 1</span><span style="color: #fff27a">● READY</span></p>
        </div>
      </div>
      <!-- texto -->
      <div style="flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
        <p style="margin: 0; font-family: 'Press Start 2P', monospace; font-size: 11px; letter-spacing: 3px; color: #3ff0ff">01 · SOBRE MÍ</p>
        <h2 style="margin: 0; font-family: 'Londrina Solid', sans-serif; font-weight: 900; font-style: italic; font-size: clamp(44px, 5.5vw, 68px); line-height: 1.05; color: #fff">Hola, soy <span style="font-family: 'Mr Dafoe', cursive; font-weight: 400; font-style: normal; font-size: 1.25em; color: #ff2fb3; text-shadow: 0 0 18px #ff2fb3">Rony</span></h2>
        <p style="margin: 0; font-size: 18px; line-height: 1.65; color: #e6d9fb">Desarrollador Fullstack con más de 5 años creando aplicaciones web y sistemas empresariales: CRM, ERP y plataformas internas, desde la base de datos y las APIs hasta la interfaz y el despliegue a producción.</p>
        <p style="margin: 0; font-size: 18px; line-height: 1.65; color: #e6d9fb">Trabajo con JavaScript y TypeScript en Node.js, React, Next.js, Vue.js, Angular y .NET. Vivo en Cancún, Quintana Roo, y estoy disponible para trabajo remoto.</p>
        <div style="margin-top: 12px">
          <p style="margin: 0 0 14px; font-family: 'Press Start 2P', monospace; font-size: 11px; letter-spacing: 2px; color: #fff27a">STATS</p>
          <dl style="margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px">
            <div style="padding: 16px; background: #160733; border: 1px solid #3a1d6e; border-radius: 6px">
              <dt style="font-family: 'Press Start 2P', monospace; font-size: 9px; color: #3ff0ff; margin-bottom: 10px">EXP</dt>
              <dd style="margin: 0; font-family: 'Londrina Solid', sans-serif; font-weight: 900; font-size: 36px; line-height: 1">5+ <span style="font-size: 16px; font-weight: 400">años</span></dd>
            </div>
            <div style="padding: 16px; background: #160733; border: 1px solid #3a1d6e; border-radius: 6px">
              <dt style="font-family: 'Press Start 2P', monospace; font-size: 9px; color: #3ff0ff; margin-bottom: 10px">ADDONS CRM</dt>
              <dd style="margin: 0; font-family: 'Londrina Solid', sans-serif; font-weight: 900; font-size: 36px; line-height: 1">~20</dd>
            </div>
            <div style="padding: 16px; background: #160733; border: 1px solid #3a1d6e; border-radius: 6px">
              <dt style="font-family: 'Press Start 2P', monospace; font-size: 9px; color: #3ff0ff; margin-bottom: 10px">USUARIOS</dt>
              <dd style="margin: 0; font-family: 'Londrina Solid', sans-serif; font-weight: 900; font-size: 36px; line-height: 1">3,000+</dd>
            </div>
            <div style="padding: 16px; background: #160733; border: 1px solid #3a1d6e; border-radius: 6px">
              <dt style="font-family: 'Press Start 2P', monospace; font-size: 9px; color: #3ff0ff; margin-bottom: 10px">MENOS BUGS</dt>
              <dd style="margin: 0; font-family: 'Londrina Solid', sans-serif; font-weight: 900; font-size: 36px; line-height: 1">-80%</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <!-- escena inferior: sol, palmeras, grid y bocina -->
    <div aria-hidden="true" style="position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; height: 330px">
      <div style="position: absolute; right: max(2%, calc(50% - 600px)); bottom: 80px; width: 320px; height: 320px; filter: drop-shadow(0 0 50px rgba(255,94,126,.55))">
        <div class="rw-hsun" style="width: 100%; height: 100%; border-radius: 50%; background: linear-gradient(180deg, #fff27a 0%, #ffb347 35%, #ff5e7e 65%, #ff2fb3 100%)"></div>
      </div>
      <div style="position: absolute; left: 0; right: 0; bottom: 0; height: 110px; overflow: hidden; border-top: 2px solid #ff2fb3; box-shadow: 0 -6px 30px rgba(255,47,179,.6); background: #12021f; perspective: 260px">
        <div class="rw-about-floor"></div>
      </div>
      <svg class="rw-hide-sm" viewBox="0 0 220 420" style="position: absolute; left: 2%; bottom: 100px; width: 170px; height: 320px">
        <path d="M120 420 C118 330 110 250 92 150" stroke="#0a0118" stroke-width="12" fill="none" stroke-linecap="round"></path>
        <g stroke="#0a0118" stroke-width="7" fill="none" stroke-linecap="round">
          <path d="M92 150 C60 120 30 125 4 150"></path>
          <path d="M92 150 C70 100 40 90 14 96"></path>
          <path d="M92 150 C96 100 120 80 150 76"></path>
          <path d="M92 150 C130 120 170 128 200 156"></path>
          <path d="M92 150 C120 150 150 175 162 210"></path>
          <path d="M92 150 C64 160 44 190 40 224"></path>
        </g>
      </svg>
      <svg viewBox="0 0 220 420" style="position: absolute; right: max(1%, calc(50% - 700px)); bottom: 100px; width: 220px; height: 420px; transform: scaleX(-1)">
        <path d="M120 420 C118 330 110 250 92 150" stroke="#0a0118" stroke-width="12" fill="none" stroke-linecap="round"></path>
        <g stroke="#0a0118" stroke-width="7" fill="none" stroke-linecap="round">
          <path d="M92 150 C60 120 30 125 4 150"></path>
          <path d="M92 150 C70 100 40 90 14 96"></path>
          <path d="M92 150 C96 100 120 80 150 76"></path>
          <path d="M92 150 C130 120 170 128 200 156"></path>
          <path d="M92 150 C120 150 150 175 162 210"></path>
          <path d="M92 150 C64 160 44 190 40 224"></path>
        </g>
      </svg>
      <!-- bocina (render del modelo 3D), debajo de la foto -->
      <div class="rw-bb-wrap" style="position: absolute; z-index: 2; left: max(2%, calc(50% - 524px)); bottom: 44px; width: 380px; height: 298px">
        <div class="rw-bb-glow" style="position: absolute; left: 6%; right: 6%; top: 30%; bottom: 4%; border-radius: 40%; background: radial-gradient(ellipse at center, rgba(255,47,179,.55), transparent 70%)"></div>
        <div class="rw-boombox" style="position: relative"></div>
      </div>
    </div>
  </section>
