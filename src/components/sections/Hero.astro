---
import site from '../../data/site.json';
import DeLorean3D from '../islands/DeLorean3D.jsx';
import HeroScene3D from '../islands/HeroScene3D.jsx';
import HeroGsap from './hero/HeroGsap.astro';
import HeroCanvas from './hero/HeroCanvas.astro';
import HeroCity3D from '../islands/HeroCity3D.jsx';
import HeroCityGsap from './hero/HeroCityGsap.astro';
import HeroCityCanvas from './hero/HeroCityCanvas.astro';
import HeroPurple3D from '../islands/HeroPurple3D.jsx';
import HeroPurpleGsap from './hero/HeroPurpleGsap.astro';
import HeroPurpleCanvas from './hero/HeroPurpleCanvas.astro';
// variant: 'css' · 'r3f' (Three.js, la portada) · 'gsap' · 'canvas' → /home1-3
//          'city-r3f' · 'city-gsap' · 'city-canvas' (camino con palmeras hacia la ciudad) → /home4-6
const { variant = 'css' } = Astro.props;
//          'purple-r3f' · 'purple-gsap' · 'purple-canvas' (sol amarillo, montañas y palmeras moradas) → /home7-9
const city = variant.startsWith('city');
const purple = variant.startsWith('purple');
const SKY = purple
  ? 'linear-gradient(to bottom, #12043a 0px, #2a0a6b 200px, #5a1aa8 360px, #a03ad0 470px, #ff7ad8 520px, #1a0838 520px)'
  : city
  ? 'linear-gradient(to bottom, #000 0px, #07021a 170px, #22083d 320px, #5c0c58 420px, #c4177a 490px, #ff4f9a 520px, #0b0420 520px)'
  : 'linear-gradient(to bottom, #0b0420 0px, #1d0a45 250px, #4a0f6b 400px, #b0186e 520px, #12021f 520px)';
const SPRITE = "<div class=\"rw-car-sprite\" role=\"img\" aria-label=\"DeLorean visto desde atr\u00e1s conduciendo hacia el sol\" style=\"width: 360px; height: 233px\"></div>";
---
<!-- ESCENA 1: HERO -->
  <section id="inicio" class={`rw-hero rw-hero--${variant}`} data-variant={variant} style={`position: relative; height: 900px; overflow: hidden; background: ${SKY}`}>
    <div aria-hidden="true" style="position: absolute; left: 0; right: 0; top: 0; height: 520px; overflow: hidden">
      <div class="rw-par" data-depth="6" style="position: absolute; inset: 0">
        <div class="rw-stars" style="position: absolute; inset: 0"></div>
        <div class="rw-stars rw-stars-2" style="position: absolute; inset: 0"></div>
        {purple && <div class="rw-stars-static rw-stars-dense" style="position: absolute; inset: 0"></div>}
      </div>
    </div>

    <!-- r3f: primer frame de la escena 3D; se ve desde el primer pintado y la escena arranca justo aquí (sin saltos) -->
    {variant === 'city-r3f' && (
      <img class="rw-hero-poster" src="/assets/hero-city-poster.webp" alt="" aria-hidden="true" width="1440" height="900" fetchpriority="high" decoding="async">
    )}
    {variant === 'city-canvas' && (
      <img class="rw-hero-poster" src="/assets/hero-city2d-poster.webp" alt="" aria-hidden="true" width="1440" height="900" fetchpriority="high" decoding="async">
    )}
    {variant === 'r3f' && (
      <img class="rw-hero-poster" src="/assets/hero-poster.webp" alt="" aria-hidden="true" width="1440" height="900" fetchpriority="high" decoding="async">
    )}
    {variant !== 'r3f' && !city && !purple && (
    <div class="rw-hero-bg" aria-hidden="true">
    <!-- sol: franjas que bajan + halo que respira (el halo es una capa aparte, sin filtros) -->
    <div class="rw-par" data-depth="10" aria-hidden="true" style="position: absolute; left: 50%; top: 236px; width: 300px; height: 300px; margin-left: -150px">
      <div class="rw-sun-halo"></div>
      <div style="position: absolute; left: 0; top: 0; width: 300px; height: 282px; overflow: hidden">
        <div class="rw-hsun-run" style="width: 300px; height: 300px; border-radius: 50%; background: linear-gradient(to bottom, #ffd23f 0%, #ffa23a 40%, #ff5a8a 70%, #ff2fd0 100%)"></div>
      </div>
    </div>

    <!-- piso: las líneas horizontales van en su propia capa; se anima con transform en la GPU -->
    <div class="rw-floor-run" aria-hidden="true">
      <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" style="position: absolute; inset: 0; width: 100%; height: 100%; filter: drop-shadow(0 0 6px #ff2fd0)">
        <g stroke="#ff3fd8" stroke-width="2.5">
          <line x1="-300" y1="968" x2="1740" y2="968" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="878.4" x2="1740" y2="878.4" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="806.7" x2="1740" y2="806.7" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="749.4" x2="1740" y2="749.4" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="703.5" x2="1740" y2="703.5" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="666.8" x2="1740" y2="666.8" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="637.4" x2="1740" y2="637.4" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="614" x2="1740" y2="614" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="595.2" x2="1740" y2="595.2" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="580.1" x2="1740" y2="580.1" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="568.1" x2="1740" y2="568.1" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="558.5" x2="1740" y2="558.5" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="550.8" x2="1740" y2="550.8" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="544.6" x2="1740" y2="544.6" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="539.7" x2="1740" y2="539.7" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="535.8" x2="1740" y2="535.8" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="532.6" x2="1740" y2="532.6" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="530.1" x2="1740" y2="530.1" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="528.1" x2="1740" y2="528.1" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="526.5" x2="1740" y2="526.5" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="525.2" x2="1740" y2="525.2" vector-effect="non-scaling-stroke"></line><line x1="-300" y1="524.1" x2="1740" y2="524.1" vector-effect="non-scaling-stroke"></line>
        </g>
      </svg>
    </div>
    <svg aria-hidden="true" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" style="position: absolute; inset: 0; width: 100%; height: 100%; filter: drop-shadow(0 0 6px #ff2fd0)">
      <g stroke="#ff3fd8" stroke-width="2.5" vector-effect="non-scaling-stroke">
        <line x1="720" y1="520" x2="74" y2="900"></line><line x1="720" y1="520" x2="203" y2="900"></line><line x1="720" y1="520" x2="332" y2="900"></line><line x1="720" y1="520" x2="462" y2="900"></line><line x1="720" y1="520" x2="591" y2="900"></line><line x1="720" y1="520" x2="720" y2="900"></line><line x1="720" y1="520" x2="849" y2="900"></line><line x1="720" y1="520" x2="978" y2="900"></line><line x1="720" y1="520" x2="1108" y2="900"></line><line x1="720" y1="520" x2="1237" y2="900"></line><line x1="720" y1="520" x2="1366" y2="900"></line>
      </g>
      <line x1="-300" y1="520" x2="1740" y2="520" stroke="#ff9ff0" stroke-width="2"></line>
    </svg>

    <!-- montañas: avanzan despacio hacia la cámara y siguen al mouse -->
    <div class="rw-par" data-depth="18" aria-hidden="true" style="position: absolute; inset: 0">
      <div class="rw-mt-run" data-mt>
        <img src="/assets/mountains.svg" alt="" style="position: absolute; inset: 0; width: 100%; height: 100%; filter: drop-shadow(0 0 4px #2f8bff) drop-shadow(0 0 10px rgba(47,139,255,.5))">
      </div>
      {variant === 'gsap' && (
        <div class="rw-mt-run" data-mt>
          <img src="/assets/mountains.svg" alt="" style="position: absolute; inset: 0; width: 100%; height: 100%; filter: drop-shadow(0 0 4px #2f8bff) drop-shadow(0 0 10px rgba(47,139,255,.5))">
        </div>
      )}
    </div>
    </div>
    )}

    {variant === 'r3f' && <HeroScene3D client:only="react" />}
    {variant === 'canvas' && <HeroCanvas />}
    {variant === 'gsap' && <HeroGsap />}
    {variant === 'city-r3f' && <HeroCity3D client:only="react" />}
    {variant === 'city-gsap' && <HeroCityGsap />}
    {variant === 'city-canvas' && <HeroCityCanvas />}
    {variant === 'purple-r3f' && <HeroPurple3D client:only="react" />}
    {variant === 'purple-gsap' && <HeroPurpleGsap />}
    {variant === 'purple-canvas' && <HeroPurpleCanvas />}

    <!-- título estilo "Synthwave Nation" -->
    <div class="rw-logo-box" style="position: absolute; z-index: 5; left: 0; right: 0; top: 92px; height: 400px; display: flex; align-items: center; justify-content: center; perspective: 600px">
      <div class="rw-logo-in">
        <div data-tilt style="position: relative; padding: 40px 24px; transform: rotateX(0deg) rotateY(0deg); transform-style: preserve-3d; transition: transform .2s linear; text-align: center">
          <svg aria-hidden="true" viewBox="0 0 560 420" style="position: absolute; left: 50%; top: -10px; width: 560px; height: 420px; margin-left: -280px; z-index: -2; filter: drop-shadow(0 0 8px #3bd0ff) drop-shadow(0 0 18px rgba(59,208,255,.6))">
            <polygon points="30,30 530,30 280,400" fill="rgba(20,6,50,.35)" stroke="#3ff0ff" stroke-width="7" stroke-linejoin="miter"></polygon>
            <polygon points="58,46 502,46 280,372" fill="none" stroke="#ff2fb3" stroke-width="2" opacity=".8"></polygon>
          </svg>
          <h1 style="margin: 0; font-weight: 400; display: flex; flex-direction: column; align-items: center">
            <span class="rw-script" style="display: block; align-self: flex-start; margin: 0 0 -38px -10px; font-size: clamp(56px, 7vw, 104px); line-height: 1; transform: rotate(-8deg); position: relative; z-index: 2">Rony</span>
            <span class="rw-chrome-wrap" style="font-size: clamp(58px, 9.5vw, 138px)"><span class="rw-chrome-depth" aria-hidden="true">VARGAS</span><span class="rw-chrome">VARGAS</span></span>
            <span class="rw-script" style="display: block; align-self: flex-end; margin: -26px -16px 0 0; font-size: clamp(36px, 4.6vw, 66px); line-height: 1.1; color: #3ff0ff; -webkit-text-stroke: 1px #e6fdff; text-shadow: 0 0 6px #3bd0ff, 0 0 18px #3bd0ff, 0 0 36px rgba(59,208,255,.6); transform: rotate(-6deg); position: relative; z-index: 2">Fullstack Developer</span>
          </h1>
          <p style="margin: 22px 0 0; font-family: 'Press Start 2P', monospace; font-size: 11px; letter-spacing: 3px; color: #fff27a; text-shadow: 0 0 10px rgba(255,224,102,.8), 0 2px 0 #3a0c5c">NODE.JS · REACT · APIs</p>
          <span class="rw-spark" aria-hidden="true" style="left: 18%; top: 34%"></span>
          <span class="rw-spark" aria-hidden="true" style="right: 12%; top: 60%; animation-delay: 1.1s"></span>
          <span class="rw-spark" aria-hidden="true" style="left: 46%; top: 30%; animation-delay: 1.8s"></span>
        </div>
      </div>
    </div>

    <!-- DeLorean conduciendo hacia el sol -->
    
      <div class="rw-car-wrap" style="position: absolute; z-index: 6; left: 50%; bottom: 26px; width: 360px; height: 233px; margin-left: -180px">
        <div class="rw-trail rw-trail-l" aria-hidden="true"></div>
        <div class="rw-trail rw-trail-r" aria-hidden="true"></div>
        <div aria-hidden="true" style="position: absolute; left: 6%; right: 6%; bottom: -6px; height: 34px; border-radius: 50%; background: radial-gradient(ellipse at center, rgba(0,0,0,.85) 0%, rgba(0,0,0,.4) 50%, transparent 72%)"></div>
        <div aria-hidden="true" style="position: absolute; left: -10%; right: -10%; bottom: -24px; height: 60px; border-radius: 50%; background: radial-gradient(ellipse at center, rgba(255,63,216,.45) 0%, transparent 70%)"></div>
        <div class="rw-car" style="position: absolute; inset: 0">
          <div class="rw-car-glow" style="position: absolute; inset: 0">
          {site.delorean3d ? <DeLorean3D client:visible /> : <Fragment set:html={SPRITE} />}
          </div>
          <div class="rw-tail-glow" aria-hidden="true" style="position: absolute; left: 10%; top: 48%; width: 22%; height: 16%; border-radius: 50%; background: radial-gradient(ellipse at center, rgba(255,22,54,.7) 0%, transparent 70%); mix-blend-mode: screen"></div>
          <div class="rw-tail-glow" aria-hidden="true" style="position: absolute; right: 10%; top: 48%; width: 22%; height: 16%; border-radius: 50%; background: radial-gradient(ellipse at center, rgba(255,22,54,.7) 0%, transparent 70%); mix-blend-mode: screen"></div>
        </div>
      </div>
    
  </section>
<script>
  // Inclinación del logo + paralaje (estrellas, sol, montañas) al mover el mouse.
  // Se calcula una vez por frame y solo se cambian transforms, que corren en la GPU.
  const hero = document.getElementById('inicio');
  const card = hero?.querySelector('[data-tilt]');
  // en la variante GSAP el paralaje lo maneja GSAP; en r3f y canvas lo maneja su propia escena
  const layers = hero && hero.dataset.variant === 'css' ? [...hero.querySelectorAll('.rw-par')] : [];
  if (hero && card && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let mx = 0, my = 0, raf = 0;
    const apply = () => {
      raf = 0;
      card.style.transform = `rotateX(${Math.round(-my * 10)}deg) rotateY(${Math.round(mx * 12)}deg)`;
      for (const el of layers) {
        const d = +el.dataset.depth;
        el.style.transform = `translate3d(${(-mx * d).toFixed(1)}px, ${(-my * d * 0.4).toFixed(1)}px, 0)`;
      }
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(apply); };
    hero.addEventListener('mousemove', (e) => {
      const r = hero.getBoundingClientRect();
      mx = ((e.clientX - r.left) / r.width - 0.5) * 2;
      my = ((e.clientY - r.top) / r.height - 0.5) * 2;
      queue();
    });
    hero.addEventListener('mouseleave', () => { mx = 0; my = 0; queue(); });
  }
  // Fuera de pantalla, el hero pausa sus animaciones para no gastar GPU mientras se ve otra sección.
  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([en]) => hero.classList.toggle('rw-off', !en.isIntersecting)).observe(hero);
  }
</script>
