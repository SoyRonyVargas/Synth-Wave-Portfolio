<!-- FORMACIÓN: high scores con planetas rocosos (render 3D propio) -->
  <section id="formacion" style="position: relative; overflow: hidden; background: radial-gradient(ellipse at 70% 20%, #22104a 0%, #0b0420 60%)">
    <div class="rw-stars-static" aria-hidden="true" style="position: absolute; inset: 0"></div>

    <img class="rw-hide-sm fp-float" src="/assets/planet-rock-big.webp" alt="" aria-hidden="true" style="position: absolute; z-index: 0; right: calc(max(4%, calc(50% - 640px)) - 165px); top: 26px; width: 470px; height: auto; filter: drop-shadow(0 0 40px rgba(255,47,179,.25))">
    <img class="rw-hide-sm fp-float" src="/assets/moon-yellow.webp" alt="" aria-hidden="true" style="position: absolute; left: max(6%, calc(50% - 600px)); top: 112px; width: 70px; height: auto; animation-delay: -2s; filter: drop-shadow(0 0 16px rgba(255,210,122,.35))">
    <img class="rw-hide-sm fp-float" src="/assets/moon-grey.webp" alt="" aria-hidden="true" style="position: absolute; left: max(11%, calc(50% - 530px)); top: 300px; width: 34px; height: auto; animation-delay: -4s"><figure class="rw-hide-sm rw-float" style="position: absolute; z-index: 1; left: max(3%, calc(50% - 680px)); bottom: 70px; width: 160px; rotate: -8deg; margin: 0"><div class="rw-joy" role="img" aria-label="Joystick de arcade"></div></figure><figure class="rw-hide-sm rw-float" style="position: absolute; z-index: 1; right: max(3%, calc(50% - 680px)); bottom: 64px; width: 140px; rotate: 10deg; margin: 0; animation-delay: .7s"><img src="/assets/cartridge-rv85.webp" alt="Cartucho RV-85 Fullstack" style="display: block; width: 100%; height: auto; filter: drop-shadow(0 0 16px rgba(255,47,179,.45)) drop-shadow(0 0 3px rgba(63,240,255,.35));"></figure><div style="position: relative; z-index: 2; max-width: 900px; margin: 0 auto; padding: 110px 24px 120px">

      <p aria-hidden="true" style="margin: 0 0 24px; display: flex; justify-content: space-between; font-family: 'Press Start 2P', monospace; font-size: 11px; color: #ff2fb3"><span>1UP</span><span style="color: #fff27a">HI-SCORE · RONY VARGAS</span><span>2UP</span></p>
      <div style="position: relative; padding: 36px 28px; border: 3px solid #3ff0ff; box-shadow: 0 0 30px rgba(63,240,255,.3), inset 0 0 30px rgba(63,240,255,.12); background: rgba(11,4,32,.85)">
        <h2 class="rw-blink-soft" style="margin: 0 0 30px; text-align: center; font-family: 'Press Start 2P', monospace; font-weight: 400; font-size: clamp(16px, 2.6vw, 24px); line-height: 1.5; color: #fff27a; text-shadow: 0 0 10px rgba(255,242,122,.6)">★ HIGH SCORES ★</h2>
        <ol style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 26px; font-family: 'Press Start 2P', monospace; font-size: 11px; line-height: 1.9">
          <li class="rw-row-in" style="display: flex; flex-wrap: wrap; align-items: flex-start; gap: 8px 18px;"><span aria-hidden="true" style="flex: 0 0 44px; display: flex; justify-content: center; margin-top: -8px"><img src="/assets/planet-rock-pink.webp" alt="" style="display: block; height: 40px; width: auto; filter: drop-shadow(0 0 10px rgba(255,47,179,.45))"></span><span style="color: #ff2fb3; flex: 0 0 48px">1ST</span><span style="flex: 1 1 260px; color: #fff">INGENIERÍA EN SOFTWARE<br><span style="color: #3ff0ff">UNIV. POLITÉCNICA DE QUINTANA ROO</span></span><span style="color: #fff27a">2022–2025</span></li>
          <li class="rw-row-in" style="display: flex; flex-wrap: wrap; align-items: flex-start; gap: 8px 18px; animation-delay: 0.25s;"><span aria-hidden="true" style="flex: 0 0 44px; display: flex; justify-content: center; margin-top: -8px"><img src="/assets/planet-rock-cyan.webp" alt="" style="display: block; height: 40px; width: auto; filter: drop-shadow(0 0 10px rgba(63,240,255,.4))"></span><span style="color: #ff2fb3; flex: 0 0 48px">2ND</span><span style="flex: 1 1 260px; color: #fff">CERTIFIED JAVASCRIPT DEVELOPER (PRO)<br><a href="https://verify.w3schools.com/684F1SEOR" style="color: #3ff0ff">W3SCHOOLS · VERIFICAR</a></span><span style="color: #fff27a">AGO 2025</span></li>
          <li class="rw-row-in" style="display: flex; flex-wrap: wrap; align-items: flex-start; gap: 8px 18px; animation-delay: 0.50s;"><span aria-hidden="true" style="flex: 0 0 44px; display: flex; justify-content: center; margin-top: -8px"><img src="/assets/planet-rock-purple.webp" alt="" style="display: block; height: 40px; width: auto; filter: drop-shadow(0 0 10px rgba(178,107,255,.45))"></span><span style="color: #ff2fb3; flex: 0 0 48px">3RD</span><span style="flex: 1 1 260px; color: #fff">IDIOMAS<br><span style="color: #3ff0ff">ESPAÑOL NATIVO · INGLÉS TÉCNICO</span></span><span style="color: #fff27a">2P</span></li>
        </ol>
        <p class="rw-blink" style="margin: 34px 0 0; text-align: center; font-family: 'Press Start 2P', monospace; font-size: 10px; color: #ff2fb3">PRESS START</p>
      </div>
</div>
  </section>
