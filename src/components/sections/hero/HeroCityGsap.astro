---
// Hero "ciudad" con GSAP (/home5): capas HTML/SVG; GSAP mueve palmeras, líneas del piso y rayas del camino.
// Proyección en unidades del viewBox 1440×900 (horizonte en y=520, cámara a 1 de altura, foco 380).
// El frame 0 se calcula aquí y se pinta con CSS: la escena se ve completa antes de que cargue GSAP.
const PALM_X = 1.75, PALM_DZ = 4.5, PALM_N = 15, PALM_H = 3.2, SPAN = PALM_DZ * PALM_N;
const ROAD = 0.9, LINE_DZ = 1.2, LINE_N = 40, DASH_P = 3, DASH_L = 1.26, DASH_N = 16;

let seed = 3;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const palms = [];
for (const side of [-1, 1])
  for (let i = 0; i < PALM_N; i++)
    palms.push({ side, off: i * PALM_DZ + (side > 0 ? PALM_DZ / 2 : 0) + rnd() * 1.2, k: 0.85 + rnd() * 0.4, dx: rnd() * 0.35 });

// posición (px a 1440×900, luego escalada con --u) de cada elemento en el frame 0
const X = (x, d) => 720 + (x * 380) / d;
const Y = (d) => 520 + 380 / d;
const at = (vx, vy) => `left: calc(50% + ${(vx - 720).toFixed(2)} * var(--u)); top: calc(900px - ${(900 - vy).toFixed(2)} * var(--u))`;
const palm0 = palms.map((p) => {
  const d = (((p.off % SPAN) + SPAN) % SPAN) - 3;
  if (d < 0.35) return { ...p, style: 'opacity: 0', mirrorStyle: 'opacity: 0' };
  const h = (PALM_H * p.k * 380) / d;
  const op = Math.min(1, Math.max(0, (SPAN * 0.95 - d) / (SPAN * 0.23)));
  const pos = `${at(X(p.side * (PALM_X + p.dx), d), Y(d))}; height: calc(${h.toFixed(2)} * var(--u)); opacity: ${op.toFixed(3)}`;
  return { ...p, style: `${pos}; transform: translate(-47%, -100%) scaleX(${-p.side})`, mirrorStyle: `${pos}; transform: translate(-47%, 0) scale(${-p.side}, -1); transform-origin: 50% 50%` };
});
const lines0 = Array.from({ length: LINE_N }, (_, i) => {
  const d = (i + 1) * LINE_DZ;
  return `top: calc(900px - ${(900 - Y(d)).toFixed(2)} * var(--u)); opacity: ${Math.max(0, 1 - d / 30).toFixed(3)}`;
});
const dashes0 = Array.from({ length: DASH_N }, (_, i) => {
  const dn = (i + 1) * DASH_P - 2, df = dn + DASH_L;
  if (dn < 0.4) return 'opacity: 0';
  const w = (0.07 * 380) / ((dn + df) / 2), h = Y(dn) - Y(df);
  return `${at(720, Y(df))}; width: calc(${w.toFixed(2)} * var(--u)); height: calc(${h.toFixed(2)} * var(--u)); transform: translateX(-50%)`;
});
const rays = [];
for (let k = 1; k <= 34; k++) for (const sgn of [-1, 1]) rays.push(720 + sgn * 380 * (ROAD + 0.6 * k));
---
<div class="cg" aria-hidden="true" data-cfg={JSON.stringify({ PALM_X, PALM_H, SPAN, LINE_DZ, DASH_P, DASH_L })}>
  <!-- cielo: sol rayado y ciudad (recortados en el horizonte) -->
  <div class="cg-sky">
    <div class="cg-halo"></div>
    <div class="cg-sun"></div>
    <img class="cg-city" src="/assets/city.webp" alt="" width="2400" height="520">
  </div>

  <!-- reflejos en el piso -->
  <div class="cg-refl">
    <div class="cg-sun cg-sun--m"></div>
    <img class="cg-city cg-city--m" src="/assets/city.webp" alt="" width="2400" height="520">
    {palm0.map((p) => <img class="cg-palm" src="/assets/palm.webp" alt="" data-side={p.side} data-off={p.off} data-k={p.k} data-dx={p.dx} data-mirror style={p.mirrorStyle}>)}
  </div>

  <!-- piso: rayos fijos + líneas que avanzan -->
  <svg class="cg-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice">
    <g stroke="#ff2fb3" stroke-width="1.6" opacity=".75">{rays.map((x) => <line x1="720" y1="520" x2={x} y2="900" vector-effect="non-scaling-stroke" />)}</g>
  </svg>
  <div class="cg-lines">{lines0.map((st) => <i style={st}></i>)}</div>

  <!-- camino oscuro con bordes cian -->
  <svg class="cg-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" style="filter: drop-shadow(0 0 5px #3ff0ff)">
    <polygon points={`720,520 ${720 - 342},900 ${720 + 342},900`} fill="#05020f" opacity=".92" />
    <g stroke="#3ff0ff" stroke-width="2.4"><line x1="720" y1="520" x2={720 - 342} y2="900" /><line x1="720" y1="520" x2={720 + 342} y2="900" /></g>
  </svg>
  <div class="cg-dashes">{dashes0.map((st) => <i style={st}></i>)}</div>

  <!-- horizonte cian -->
  <div class="cg-haze"></div>
  <div class="cg-horizon"></div>

  <div class="cg-palms">
    {palm0.map((p) => <img class="cg-palm" src="/assets/palm.webp" alt="" data-side={p.side} data-off={p.off} data-k={p.k} data-dx={p.dx} style={p.style}>)}
  </div>
</div>

<style>
  /* --u = 1px escalado como los SVG "slice" (crece con pantallas de más de 1440 px) */
  .cg { --u: max(1px, calc(100vw / 1440)); --hy: calc(900px - 380 * var(--u)); position: absolute; inset: 0; z-index: 0 }
  .cg-full { position: absolute; inset: 0; width: 100%; height: 100% }
  .cg-sky { position: absolute; left: 0; right: 0; top: 0; height: var(--hy); overflow: hidden }
  .cg-sun, .cg-halo { position: absolute; left: 50%; border-radius: 50% }
  .cg-sun { width: calc(350 * var(--u)); height: calc(350 * var(--u)); margin-left: calc(-175 * var(--u)); top: calc(var(--hy) - 270 * var(--u));
    background: linear-gradient(to bottom, #ffd63f 0%, #ffa03a 42%, #ff5486 70%, #ff2fb3 100%);
    -webkit-mask-image: linear-gradient(#000 0 52%, transparent 52%), repeating-linear-gradient(#000 0 20px, transparent 20px 30px);
    mask-image: linear-gradient(#000 0 52%, transparent 52%), repeating-linear-gradient(#000 0 20px, transparent 20px 30px);
    -webkit-mask-size: 100% 100%, 100% 30px; mask-size: 100% 100%, 100% 30px; -webkit-mask-repeat: no-repeat, repeat; mask-repeat: no-repeat, repeat;
    -webkit-mask-position: 0 0, 0 var(--sun-y, 0px); mask-position: 0 0, 0 var(--sun-y, 0px) }
  .cg-halo { width: calc(640 * var(--u)); height: calc(640 * var(--u)); margin-left: calc(-320 * var(--u)); top: calc(var(--hy) - 415 * var(--u));
    background: radial-gradient(circle, rgba(255,110,150,.6) 0, rgba(255,47,179,.22) 40%, transparent 68%); will-change: transform, opacity }
  .cg-city { position: absolute; left: 50%; bottom: 0; width: calc(1150 * var(--u)); height: auto; max-width: none; transform: translateX(-50%) scale(.5); transform-origin: 50% 100% }
  .cg-refl { position: absolute; inset: 0; clip-path: inset(var(--hy) 0 0 0); opacity: .32 }
  .cg-sun--m { top: calc(var(--hy) - 80 * var(--u)); transform: scaleY(-1) }
  .cg-city--m { bottom: auto; top: var(--hy); transform: translateX(-50%) scale(.5, -.5); transform-origin: 50% 0 }
  .cg-lines i { position: absolute; left: 0; right: 0; height: 2px; margin-top: -1px; background: #ff2fb3; box-shadow: 0 0 6px #ff2fb3 }
  .cg-dashes i { position: absolute; background: #3ff0ff; box-shadow: 0 0 6px #3ff0ff }
  .cg-haze { position: absolute; left: 0; right: 0; top: calc(var(--hy) - 120 * var(--u)); height: calc(120 * var(--u)); background: linear-gradient(transparent, rgba(255,47,179,.35)) }
  .cg-horizon { position: absolute; left: 0; right: 0; top: calc(var(--hy) - 1px); height: 3px; background: #9ff8ff; box-shadow: 0 0 8px #3ff0ff, 0 0 22px #3ff0ff, 0 0 46px rgba(63,240,255,.6) }
  .cg-palms { position: absolute; inset: 0; z-index: 0 }
  .cg-palm { position: absolute; width: auto; max-width: none; transform-origin: 47% 100% }
</style>

<script>
  import { gsap } from 'gsap';
  const hero = document.getElementById('inicio');
  const root = hero?.querySelector('.cg');
  if (hero && root && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const C = JSON.parse(root.dataset.cfg);
    const sun = root.querySelector('.cg-sun');
    const [city, cityM] = root.querySelectorAll('.cg-city');
    const car = hero.querySelector('.rw-car');

    // el paralaje del mouse solo mueve el cielo (sol y ciudad); el piso es fijo como en los SVG
    // GSAP toma el control de las palmeras: posición absoluta en px con transforms (corre en la GPU)
    const palms = [...root.querySelectorAll('.cg-palm')].map((el) => {
      gsap.set(el, { clearProps: 'transform,transformOrigin' }); // se descarta el transform del frame 0 en CSS
      gsap.set(el, { left: 0, top: 0, height: 840, xPercent: -47, yPercent: -100, transformOrigin: '47% 100%' });
      return {
        el, side: +el.dataset.side, off: +el.dataset.off, k: +el.dataset.k, dx: +el.dataset.dx, mirror: el.hasAttribute('data-mirror'),
        x: gsap.quickSetter(el, 'x', 'px'), y: gsap.quickSetter(el, 'y', 'px'), sx: gsap.quickSetter(el, 'scaleX'), sy: gsap.quickSetter(el, 'scaleY'), op: gsap.quickSetter(el, 'opacity'),
      };
    });
    const lines = [...root.querySelectorAll('.cg-lines i')].map((el) => {
      gsap.set(el, { top: 0 });
      return { y: gsap.quickSetter(el, 'y', 'px'), op: gsap.quickSetter(el, 'opacity') };
    });
    const dashes = [...root.querySelectorAll('.cg-dashes i')].map((el) => {
      gsap.set(el, { clearProps: 'transform' });
      gsap.set(el, { left: 0, top: 0, width: 1, height: 1, transformOrigin: '0 0' });
      return { x: gsap.quickSetter(el, 'x', 'px'), y: gsap.quickSetter(el, 'y', 'px'), sx: gsap.quickSetter(el, 'scaleX'), sy: gsap.quickSetter(el, 'scaleY'), op: gsap.quickSetter(el, 'opacity') };
    });

    // sol: franjas que bajan y halo que respira
    gsap.to(root.querySelectorAll('.cg-sun'), { '--sun-y': '30px', duration: 1.6, ease: 'none', repeat: -1 });
    gsap.fromTo(root.querySelector('.cg-halo'), { opacity: 0.7, scale: 0.94 }, { opacity: 1, scale: 1.06, duration: 2.4, ease: 'sine.inOut', yoyo: true, repeat: -1 });
    // auto: rebote + vaivén suave
    car.style.animation = 'none';
    gsap.to(car, { y: -3, duration: 0.35, ease: 'sine.inOut', yoyo: true, repeat: -1 });
    gsap.to(car, { x: 8, rotation: 0.6, duration: 2.8, ease: 'sine.inOut', yoyo: true, repeat: -1 });

    let W = 0, H = 0, sp = 1, ox = 0, oy = 0;
    const resize = () => { const r = hero.getBoundingClientRect(); W = r.width; H = r.height; sp = Math.max(W / 1440, H / 900); ox = (W - 1440 * sp) / 2; oy = H - 900 * sp; };
    resize(); addEventListener('resize', resize);
    const px = (vx) => ox + vx * sp, py = (vy) => oy + vy * sp;

    let t = 0, travel = 0, camX = 0, mx = 0, on = true;
    hero.addEventListener('mousemove', (e) => { const r = hero.getBoundingClientRect(); mx = ((e.clientX - r.left) / r.width - 0.5) * 2; });
    hero.addEventListener('mouseleave', () => { mx = 0; });

    gsap.ticker.add((_, dtMs) => {
      if (!on) return;
      const dt = Math.min(dtMs, 50) / 1000;
      t += dt; travel += dt * 6;
      camX += (mx * 0.3 - camX) * Math.min(1, dt * 3);
      // ciudad que se acerca (misma curva que la versión 3D)
      const k = 0.5 + 0.5 * (1 - Math.exp(-t / 14));
      gsap.set(city, { scale: k, x: -camX * 8 }); gsap.set(cityM, { scaleX: k, scaleY: -k, x: -camX * 8 });
      gsap.set(sun, { x: -camX * 10 });

      for (const p of palms) {
        const d = (((p.off - travel) % C.SPAN) + C.SPAN) % C.SPAN - 3;
        if (d < 0.35) { p.op(0); continue; }
        const vx = 720 + (p.side * (C.PALM_X + p.dx) * 380) / d, vy = 520 + 380 / d;
        const s = ((C.PALM_H * p.k * 380) / d) * sp / 840;
        p.x(px(vx)); p.y(py(vy)); p.sx(-p.side * s); p.sy(p.mirror ? -s : s);
        p.op(Math.min(1, Math.max(0, (C.SPAN * 0.95 - d) / (C.SPAN * 0.23))));
        p.el.style.zIndex = String(1000 - Math.round(d * 10));
      }
      const lt = travel % C.LINE_DZ;
      lines.forEach((l, i) => { const d = (i + 1) * C.LINE_DZ - lt; l.y(py(520 + 380 / d)); l.op(Math.max(0, Math.min(1, 1 - d / 30, (d - 0.3) * 4))); });
      const dt3 = travel % C.DASH_P;
      dashes.forEach((q, i) => {
        const dn = (i + 1) * C.DASH_P - 2 - dt3, df = dn + C.DASH_L;
        if (dn < 0.4) { q.op(0); return; }
        const w = (0.07 * 380) / ((dn + df) / 2) * sp, yTop = py(520 + 380 / df), yBot = py(520 + 380 / dn);
        q.x(px(720) - w / 2); q.y(yTop); q.sx(w); q.sy(yBot - yTop); q.op(1);
      });
    });

    new IntersectionObserver(([en]) => { on = en.isIntersecting; on ? gsap.globalTimeline.resume() : gsap.globalTimeline.pause(); }).observe(hero);
  }
</script>
