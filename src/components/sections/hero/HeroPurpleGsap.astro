---
// Hero morado con GSAP (/home8): capas HTML/SVG. GSAP mueve palmeras, líneas, rayas amarillas y acerca las montañas.
// Proyección en unidades del viewBox 1440×900 (horizonte y=520, cámara a 1 de altura, foco 380).
const ROAD = 1.3, MT_IN = 3.1;
const PALM_X = 2.25, PALM_DZ = 4, PALM_N = 16, PALM_H = 3.4, SPAN = PALM_DZ * PALM_N;
const LINE_DZ = 2.4, LINE_N = 24;
const DASHES = [ { x: 0, p: 3.2, l: 1.6, ph: 0, w: 0.05 }, { x: -(ROAD - 0.12), p: 4, l: 2.2, ph: 1, w: 0.06 }, { x: ROAD - 0.12, p: 4, l: 2.2, ph: 1, w: 0.06 } ];

let seed = 5;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const palms = [];
for (const side of [-1, 1])
  for (let i = 0; i < PALM_N; i++)
    palms.push({ side, off: i * PALM_DZ + (side > 0 ? PALM_DZ / 2 : 0) + rnd(), k: 0.9 + rnd() * 0.45, dx: rnd() * 0.3 });

const X = (x, d) => 720 + (x * 380) / d;
const Y = (d) => 520 + 380 / d;
const at = (vx, vy) => `left: calc(50% + ${(vx - 720).toFixed(2)} * var(--u)); top: calc(900px - ${(900 - vy).toFixed(2)} * var(--u))`;
const palm0 = palms.map((p) => {
  const d = (((p.off % SPAN) + SPAN) % SPAN) - 3;
  if (d < 0.35) return { ...p, style: 'opacity: 0', mirrorStyle: 'opacity: 0' };
  const h = (PALM_H * p.k * 380) / d;
  const op = Math.min(1, Math.max(0, (SPAN * 0.95 - d) / (SPAN * 0.23)));
  const pos = `${at(X(p.side * (PALM_X + p.dx), d), Y(d))}; height: calc(${h.toFixed(2)} * var(--u)); opacity: ${op.toFixed(3)}`;
  return { ...p, style: `${pos}; transform: translate(-47%, -100%) scaleX(${-p.side})`, mirrorStyle: `${pos}; transform: translate(-47%, 0) scale(${-p.side}, -1); transform-origin: 50% 50%` };
});
const lines0 = Array.from({ length: LINE_N }, (_, i) => {
  const d = (i + 1) * LINE_DZ;
  return `top: calc(900px - ${(900 - Y(d)).toFixed(2)} * var(--u)); opacity: ${Math.max(0, 1 - d / 40).toFixed(3)}`;
});
const dashes0 = DASHES.flatMap((q) => Array.from({ length: 16 }, (_, i) => {
  const dn = (i + 1) * q.p - 2 - (q.ph % q.p), df = dn + q.l;
  if (dn < 0.4) return { q, style: 'opacity: 0' };
  const w = (q.w * 2 * 380) / ((dn + df) / 2), h = Y(dn) - Y(df);
  return { q, style: `${at(X(q.x, (dn + df) / 2), Y(df))}; width: calc(${w.toFixed(2)} * var(--u)); height: calc(${h.toFixed(2)} * var(--u)); transform: translateX(-50%)` };
}));

// montañas low-poly: el terreno a ambos lados, proyectado a SVG (de lejos a cerca, cada cara con su sombreado)
const hash = (a, b) => { let h = (a * 374761393 + b * 668265263) | 0; h = Math.imul(h ^ (h >>> 13), 1274126177); return ((h ^ (h >>> 16)) >>> 0) / 4294967295; };
const SIDE = []; for (let k = 0, x = MT_IN; k < 16; k++, x = x * 1.25 + 0.3) SIDE.push(x);
const MXS = [...SIDE.map((x) => -x).reverse(), ...SIDE], HALF = MXS.length / 2;
const mtH = (c, j) => { const ax = Math.abs(MXS[c]); return Math.min(1, (ax - MT_IN) / 1.4) * (1 + ax * 0.32) * (0.3 + 0.7 * hash(c, j)); };
const MDZ = 1.2, faces = [];
const proj = (c, j) => { const d = j * MDZ, k = 380 / d; return [720 + MXS[c] * k, 520 + 380 / d - mtH(c, j) * k]; };
for (let j = 45; j >= 1; j--) {
  const d = j * MDZ, fog = Math.min(1, Math.max(0, (d - 30) / 25));
  for (let c = 0; c < MXS.length - 1; c++) {
    if (c === HALF - 1) continue;
    const pts = [proj(c, j + 1), proj(c + 1, j + 1), proj(c + 1, j), proj(c, j)];
    const slope = mtH(c, j + 1) + mtH(c + 1, j + 1) - mtH(c, j) - mtH(c + 1, j);
    const side = (mtH(c + 1, j) - mtH(c, j)) * Math.sign(MXS[c]);
    const lit = Math.max(0, Math.min(1, 0.45 + side * 0.25 - slope * 0.15)), rim = Math.max(0, Math.min(1, slope * 0.35));
    const r = 34 + 90 * lit + 200 * rim, g = 10 + 55 * lit + 150 * rim, b = 76 + 140 * lit + 20 * rim;
    const fill = `rgb(${(r + (190 - r) * fog) | 0},${(g + (90 - g) * fog) | 0},${(b + (230 - b) * fog) | 0})`;
    faces.push({ pts: pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' '), fill, op: (0.75 * (1 - fog * 0.7)).toFixed(2) });
  }
}
---
<div class="pg" aria-hidden="true" data-cfg={JSON.stringify({ PALM_X, PALM_H, SPAN, LINE_DZ, ROAD, MT_IN })}>
  <div class="pg-sky">
    <div class="pg-halo"></div>
    <div class="pg-sun"></div>
  </div>

  <div class="pg-refl">
    <div class="pg-sun pg-sun--m"></div>
    {palm0.map((p) => <img class="pg-palm" src="/assets/palm-violet.webp" alt="" data-side={p.side} data-off={p.off} data-k={p.k} data-dx={p.dx} data-mirror style={p.mirrorStyle}>)}
  </div>

  <!-- piso: cuadrícula amarilla a los lados -->
  <svg class="pg-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" style="filter: drop-shadow(0 0 4px #ffb020)">
    <g stroke="#ffd65a" stroke-width="2">{[-1, 1].flatMap((s) => [0, 1, 2, 3].map((k) => <line x1="720" y1="520" x2={720 + s * 380 * (ROAD + 0.9 * k)} y2="900" vector-effect="non-scaling-stroke" />))}</g>
  </svg>
  <div class="pg-lines">{lines0.map((st) => <i style={st}></i>)}</div>
  <svg class="pg-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice">
    <defs><linearGradient id="pg-road" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3c146e" stop-opacity=".85" /><stop offset="1" stop-color="#0c041e" stop-opacity=".9" /></linearGradient></defs>
    <polygon points={`720,520 ${720 - ROAD * 380},900 ${720 + ROAD * 380},900`} fill="url(#pg-road)" />
  </svg>
  <div class="pg-dashes">{dashes0.map(({ q, style }) => <i data-x={q.x} data-p={q.p} data-l={q.l} data-ph={q.ph} data-w={q.w} style={style}></i>)}</div>
  <div class="pg-haze"></div>

  <!-- montañas: dos copias que se acercan desde el punto de fuga y se relevan -->
  {[0, 1].map(() => (
    <div class="pg-mt" data-mt>
      <svg class="pg-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice">
        {faces.map((f) => <polygon points={f.pts} fill={f.fill} stroke="#ecd2ff" stroke-opacity={f.op} stroke-width="1.1" stroke-linejoin="round" />)}
      </svg>
    </div>
  ))}

  <div class="pg-palms">
    {palm0.map((p) => <img class="pg-palm" src="/assets/palm-violet.webp" alt="" data-side={p.side} data-off={p.off} data-k={p.k} data-dx={p.dx} style={p.style}>)}
  </div>
</div>

<style>
  .pg { --u: max(1px, calc(100vw / 1440)); --hy: calc(900px - 380 * var(--u)); position: absolute; inset: 0; z-index: 0 }
  .pg-full { position: absolute; inset: 0; width: 100%; height: 100% }
  .pg-sky { position: absolute; left: 0; right: 0; top: 0; height: var(--hy); overflow: hidden }
  .pg-sun, .pg-halo { position: absolute; left: 50%; border-radius: 50% }
  .pg-sun { width: calc(460 * var(--u)); height: calc(460 * var(--u)); margin-left: calc(-230 * var(--u)); top: calc(var(--hy) - 340 * var(--u));
    background: linear-gradient(to bottom, #fff79e 0%, #ffd640 45%, #ff9a40 72%, #ff59c0 100%);
    -webkit-mask-image: linear-gradient(#000 0 46%, transparent 46%), repeating-linear-gradient(#000 0 22px, transparent 22px 32px);
    mask-image: linear-gradient(#000 0 46%, transparent 46%), repeating-linear-gradient(#000 0 22px, transparent 22px 32px);
    -webkit-mask-size: 100% 100%, 100% 32px; mask-size: 100% 100%, 100% 32px; -webkit-mask-repeat: no-repeat, repeat; mask-repeat: no-repeat, repeat;
    -webkit-mask-position: 0 0, 0 var(--sun-y, 0px); mask-position: 0 0, 0 var(--sun-y, 0px) }
  .pg-halo { width: calc(820 * var(--u)); height: calc(820 * var(--u)); margin-left: calc(-410 * var(--u)); top: calc(var(--hy) - 520 * var(--u));
    background: radial-gradient(circle, rgba(255,180,235,.55) 0, rgba(255,120,230,.2) 40%, transparent 68%) }
  .pg-refl { position: absolute; inset: 0; clip-path: inset(var(--hy) 0 0 0); opacity: .38 }
  .pg-sun--m { top: var(--hy); transform: scaleY(-1); transform-origin: 50% 0 }
  .pg-lines i { position: absolute; left: 0; right: 0; height: 2px; margin-top: -1px; background: #ffd65a; box-shadow: 0 0 6px #ffb020 }
  .pg-dashes i { position: absolute; background: #ffe36a; box-shadow: 0 0 10px #ffb020 }
  .pg-haze { position: absolute; left: 0; right: 0; top: calc(var(--hy) - 30px); height: 60px; background: linear-gradient(transparent, rgba(255,170,240,.55), transparent) }
  .pg-mt { position: absolute; inset: 0; transform-origin: 50% calc(100% - max(380px, 26.389vw)) }
  .pg-mt + .pg-mt { opacity: 0 }
  .pg-palms { position: absolute; inset: 0; z-index: 0 }
  .pg-palm { position: absolute; width: auto; max-width: none; transform-origin: 47% 100% }
</style>

<script>
  import { gsap } from 'gsap';
  const hero = document.getElementById('inicio');
  const root = hero?.querySelector('.pg');
  if (hero && root && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const C = JSON.parse(root.dataset.cfg);
    const car = hero.querySelector('.rw-car');

    const palms = [...root.querySelectorAll('.pg-palm')].map((el) => {
      gsap.set(el, { clearProps: 'transform,transformOrigin' });
      gsap.set(el, { left: 0, top: 0, height: 840, xPercent: -47, yPercent: -100, transformOrigin: '47% 100%' });
      return { el, side: +el.dataset.side, off: +el.dataset.off, k: +el.dataset.k, dx: +el.dataset.dx, mirror: el.hasAttribute('data-mirror'),
        x: gsap.quickSetter(el, 'x', 'px'), y: gsap.quickSetter(el, 'y', 'px'), sx: gsap.quickSetter(el, 'scaleX'), sy: gsap.quickSetter(el, 'scaleY'), op: gsap.quickSetter(el, 'opacity') };
    });
    const lines = [...root.querySelectorAll('.pg-lines i')].map((el) => { gsap.set(el, { top: 0 }); return { y: gsap.quickSetter(el, 'y', 'px'), op: gsap.quickSetter(el, 'opacity') }; });
    const dashes = [...root.querySelectorAll('.pg-dashes i')].map((el, i) => {
      gsap.set(el, { clearProps: 'transform' });
      gsap.set(el, { left: 0, top: 0, width: 1, height: 1, transformOrigin: '0 0' });
      return { i: i % 16, X0: +el.dataset.x, P: +el.dataset.p, L: +el.dataset.l, PH: +el.dataset.ph, W: +el.dataset.w,
        x: gsap.quickSetter(el, 'x', 'px'), y: gsap.quickSetter(el, 'y', 'px'), sx: gsap.quickSetter(el, 'scaleX'), sy: gsap.quickSetter(el, 'scaleY'), op: gsap.quickSetter(el, 'opacity') };
    });
    const mts = [...root.querySelectorAll('[data-mt]')].map((el) => ({ el, s: gsap.quickSetter(el, 'scale'), op: gsap.quickSetter(el, 'opacity') }));

    gsap.to(root.querySelectorAll('.pg-sun'), { '--sun-y': '32px', duration: 1.8, ease: 'none', repeat: -1 });
    gsap.fromTo(root.querySelector('.pg-halo'), { opacity: 0.75, scale: 0.95 }, { opacity: 1, scale: 1.05, duration: 2.4, ease: 'sine.inOut', yoyo: true, repeat: -1 });
    car.style.animation = 'none';
    gsap.to(car, { y: -3, duration: 0.35, ease: 'sine.inOut', yoyo: true, repeat: -1 });
    gsap.to(car, { x: 8, rotation: 0.6, duration: 2.8, ease: 'sine.inOut', yoyo: true, repeat: -1 });

    let W = 0, H = 0, sp = 1, ox = 0, oy = 0;
    const resize = () => { const r = hero.getBoundingClientRect(); W = r.width; H = r.height; sp = Math.max(W / 1440, H / 900); ox = (W - 1440 * sp) / 2; oy = H - 900 * sp; };
    resize(); addEventListener('resize', resize);
    const px = (vx) => ox + vx * sp, py = (vy) => oy + vy * sp;

    let t = 0, travel = 0, on = true;
    gsap.ticker.add((_, dtMs) => {
      if (!on) return;
      const dt = Math.min(dtMs, 50) / 1000;
      t += dt; travel += dt * 6;
      // montañas: cada copia crece de 1 a 1.5 desde el punto de fuga; la de adelante se desvanece al pasar
      mts.forEach((m, i) => {
        const p = (t / 6 + i / 2) % 1;
        m.s(Math.pow(1.5, p)); m.op(p < 0.3 ? p / 0.3 : p > 0.8 ? (1 - p) / 0.2 : 1); m.el.style.zIndex = String(Math.round(p * 10));
      });
      for (const p of palms) {
        const d = (((p.off - travel) % C.SPAN) + C.SPAN) % C.SPAN - 3;
        if (d < 0.35) { p.op(0); continue; }
        const s = ((C.PALM_H * p.k * 380) / d) * sp / 840;
        p.x(px(720 + (p.side * (C.PALM_X + p.dx) * 380) / d)); p.y(py(520 + 380 / d)); p.sx(-p.side * s); p.sy(p.mirror ? -s : s);
        p.op(Math.min(1, Math.max(0, (C.SPAN * 0.95 - d) / (C.SPAN * 0.23))));
        p.el.style.zIndex = String(1000 - Math.round(d * 10));
      }
      const lt = travel % C.LINE_DZ;
      lines.forEach((l, i) => { const d = (i + 1) * C.LINE_DZ - lt; l.y(py(520 + 380 / d)); l.op(Math.max(0, Math.min(1, 1 - d / 40, (d - 0.3) * 3))); });
      for (const q of dashes) {
        const dn = (q.i + 1) * q.P - 2 - ((travel + q.PH) % q.P), df = dn + q.L;
        if (dn < 0.4) { q.op(0); continue; }
        const dm = (dn + df) / 2, w = (q.W * 2 * 380) / dm * sp, yTop = py(520 + 380 / df), yBot = py(520 + 380 / dn);
        q.x(px(720 + (q.X0 * 380) / dm) - w / 2); q.y(yTop); q.sx(w); q.sy(yBot - yTop); q.op(1);
      }
    });
    new IntersectionObserver(([en]) => { on = en.isIntersecting; on ? gsap.globalTimeline.resume() : gsap.globalTimeline.pause(); }).observe(hero);
  }
</script>
