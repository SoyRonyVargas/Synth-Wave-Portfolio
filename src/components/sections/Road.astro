---
---
<!-- TRANSICIÓN: el DeLorean cruza la carretera hacia la experiencia -->
  <div aria-hidden="true" style="position: relative; height: 240px; overflow: hidden; background: linear-gradient(180deg, #12021f 0%, #160733 45%, #12021f 100%)">
    <div class="rw-stars-static" style="position: absolute; inset: 0 0 70% 0; opacity: .6"></div>
    <!-- carretera -->
    <div style="position: absolute; left: 0; right: 0; top: 70px; height: 120px; background: linear-gradient(180deg, #1d0c3a 0%, #120626 100%); border-top: 3px solid #3ff0ff; border-bottom: 3px solid #ff2fb3; box-shadow: 0 -6px 26px rgba(63,240,255,.45), 0 8px 30px rgba(255,47,179,.5)"></div>
    <div class="rw-road-dash" style="position: absolute; left: 0; right: 0; top: 128px; height: 4px"></div>
    <!-- 88 MPH -->
    <p class="rw-mph" style="position: absolute; z-index: 3; right: max(16px, calc(50% - 600px)); top: 12px; margin: 0">88 <span>MPH</span></p>
    <!-- estelas de fuego -->
    <div class="rw-fire" style="position: absolute; z-index: 1; left: 0; right: 0; top: 150px; height: 26px"><span style="top: 0; opacity: .7; height: 4px"></span><span style="top: 15px"></span></div>
    <!-- DeLorean de lado -->
    <div class="rw-dl-run" style="position: absolute; z-index: 2; top: 4px; width: 440px; height: 169px">
      <span class="rw-dl-speed"></span>
      <img src="/assets/delorean-side.webp" alt="" style="display: block; width: 440px; height: 169px; filter: drop-shadow(0 0 14px rgba(255,47,179,.55))">
      <span class="rw-wheel" style="left: 19.4%; top: 74%"></span>
      <span class="rw-wheel" style="left: 75%; top: 76.8%"></span>
    </div>
  </div>
